# boober: building time, anxiously
#
# MAX 75 pixels @ 05:55 ; MIN 60 @ (ex) 11:11, 17:17 etc
#
# set up 68 pixels, single-high stacks

--- colors ---
boober:    (255, 255, 0)
bright_y:  (255, 255, 0)
dull_y:    (64, 64, 0)
idle_y:    (1, 1, 0)
brick:     (16, 255, 0)
pile_bg:   (0, 0, 0)

# Ramp coef tuned so a full 5-unit cell reads as (200, 20, 0) —
# saturated orange-red next to the amber backdrop; a 1-unit cell is
# dim (40, 4, 0). No decay: bricks are conserved.
heap: ramp (40.0, 4.0, 0.0) decay 0/1

night:
  boober: (0, 0, 0)
  bright_y: (0, 0, 0)
  dull_y: (0, 0, 0)
  idle_y: (0, 0, 0)
  brick: (0, 1, 0)
  heap: ramp (0, 0, 0)

--- landmarks ---
# Single unioned landmark. Fetching uses `seek highest heap on
# landmark piles` (go to the tallest non-empty stack); returning uses
# `seek highest heap < 5 on landmark piles` (top up the tallest
# stack that's still below the cap). Same landmark serves both;
# workers naturally cluster around whichever pile has action.
piles: pile_bg
  (0, max_y)
  (max_x, max_y)
  (0, max_y-1)
  (max_x, max_y-1)
  (0, max_y-2)
  (max_x, max_y-2)
  (0, max_y-3)
  (max_x, max_y-3)
  (0, max_y-4)
  (max_x, max_y-4)

bottom: pile_bg
  (0, max_y)
  (max_x, max_y)

--- agents ---
up to 2 boober
boober: state { idle, carrying, returning, starting }
boober starts at (0, 0),     state = starting
boober starts at (max_x, 0), state = starting

--- simulation ---
tick rate: 400ms

--- pathfinding ---
boober:
  max nodes: 256
  plan horizon: 32
  step rate: 1
  diagonal: allowed
  diagonal_cost: 1.414
  penalty lit cell:      30     # don't walk through the clock face
  penalty occupied cell: 50
  drunkenness: 0.1

--- behavior ---
boober:
  if state == starting:
    seek bottom
    incr heap
    incr heap
    incr heap
    incr heap
    incr heap # 5 * 2
    incr heap
    incr heap
    incr heap
    incr heap
    incr heap # 10 * 2
    step (0, -1)
    incr heap
    incr heap
    incr heap
    incr heap
    incr heap # 15 * 2
    incr heap
    incr heap
    incr heap
    incr heap
    incr heap # 20 * 2
    step (0, -1)
    incr heap
    incr heap
    incr heap
    incr heap
    incr heap # 25 * 2
    incr heap
    incr heap
    incr heap
    incr heap
    incr heap # 30 * 2
    step (0, -1)
    incr heap # 31 x 2 = 62
    incr heap # 32 x 2 = 64
    incr heap # 33 x 2 = 66
    # incr heap # 34 x 2 = 68
    set state = idle

  # randomly hesitate
  if random 25%:
    pause
    if random 25%:
      pause 2
      if random 25%:
        pause 4

  # --- carrying a brick: place it on a missing clock cell ---
  if state == carrying:
    set color = bright_y
    if missing:
      seek missing timeout 30
      if on missing:
        draw brick
        pause 2
        set state = idle
        done
    # no demand — take the brick back to a pile
    set state = returning
    # FALLTHROUGH

  # --- returning: drop the brick on a pile cell with room ---
  if state == returning:
    set color = bright_y
    seek bottom
    seek highest heap < 1 on landmark piles timeout 20
    if on landmark piles:
      incr heap
      pause 2
      set state = idle
      # fallthrough
    wander avoiding current
    done

  # --- scavenge misplaced bricks, else fetch for the clock ---
  set color = dull_y

  if extra:
    seek extra not on piles timeout 20
    if on extra:
      erase
      pause
      if missing:
        set state = carrying
        done
      set state = returning
      done
    # FALLTHROUGH — no reachable extra; try a missing cell instead

  if missing:
    seek lowest heap on landmark piles timeout 20
    if on heap:
      decr heap
      pause 2
      set state = carrying
      done
    # Pile dry — stand in
    seek missing
    if on missing:
      set color = brick
      pause 75-112 # 30-45s
      set color = dull_y
    # set state = idle
    # done

  # idle
  set color = idle_y

  if random 20%:
    wander avoiding any
  pause
  done
